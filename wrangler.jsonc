{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "go-health-monitor",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "STATUS" }
  ],
  "send_email": [
    {
      "name": "ALERT_EMAIL",
      "destination_address": "monitoring@experiencewhimsy.com",
      "allowed_sender_addresses": ["warden@experiencewhimsy.com"]
    }
  ],
  "vars": {
    "ALERT_FROM": "warden@experiencewhimsy.com",
    "ALERT_TO": "monitoring@experiencewhimsy.com",
    "LATENCY_THRESHOLD_MS": "500"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
